{% extends 'user/user-dashboard.html.twig' %}

{% block content %}
    <div class="border border-dark rounded-1 px-5 py-3 bg-body">
        <h2>Modifier mon mot de passe</h2>

        {{ form_start(form, {
            attr: {
                class: 'row g-3 mt-3'
            }
        }) }}
        <div class="col-12">
            <div class="form-floating mb-3">
                {{ form_widget(form.current_password) }}
                {{ form_label(form.current_password) }}
                {{ form_errors(form.current_password) }}
            </div>
            <div class="mb-3">
                {% include 'security/_password_field.html.twig' with {field: form.new_password.first} only %}
            </div>
            <div class="mb-3">
                {% include 'security/_password_field.html.twig' with {field: form.new_password.second, rules: false} only %}
            </div>
        </div>
        <div class="d-grid col-md-8 mx-auto mb-5">
            {{ form_widget(form.submit) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
