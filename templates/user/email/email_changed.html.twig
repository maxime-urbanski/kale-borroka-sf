{% extends 'email/_layout.html.twig' %}

{# Sent to the old address once App\Account\EmailChange has applied the change: `newEmail`. #}
{% block preheader %}Ton compte Kale Borroka utilise maintenant une autre adresse.{% endblock %}

{% block content %}
    <h1 style="margin:0 0 20px;font-family:Impact,'Arial Narrow',Arial,sans-serif;font-size:36px;font-weight:400;line-height:1;text-transform:uppercase;">Adresse changée</h1>
    <p style="margin:0 0 16px;">Salut,</p>
    <p style="margin:0 0 24px;">Ton compte Kale Borroka Records utilise maintenant l’adresse <strong>{{ newEmail }}</strong>. Les prochains e-mails (commandes, alertes) partiront là-bas.</p>
    <p style="margin:0;padding:12px 14px;border:2px dashed #111010;font-size:14px;"><strong>Ce n'est pas toi&nbsp;?</strong> Réponds à ce message tout de suite&nbsp;: on remettra ton compte entre tes mains.</p>
{% endblock %}
