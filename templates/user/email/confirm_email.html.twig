{% extends 'email/_layout.html.twig' %}

{# Sent to the new address by App\Account\EmailChange: `link`, signed, valid 24 hours. #}
{% block preheader %}Un clic pour que ton compte Kale Borroka utilise cette adresse.{% endblock %}

{% block content %}
    <h1 style="margin:0 0 20px;font-family:Impact,'Arial Narrow',Arial,sans-serif;font-size:36px;font-weight:400;line-height:1;text-transform:uppercase;">Nouvelle adresse</h1>
    <p style="margin:0 0 16px;">Salut,</p>
    <p style="margin:0 0 24px;">Tu as demandé que ton compte Kale Borroka Records utilise désormais cette adresse e-mail. Pour confirmer&nbsp;:</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
        <tr>
            <td style="background-color:#111010;">
                <a href="{{ link }}" style="display:inline-block;padding:16px 26px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;color:#f3eee4;">Confirmer cette adresse</a>
            </td>
        </tr>
    </table>
    <p style="margin:0 0 16px;">Le lien marche 24&nbsp;heures, une fois connecté à ton compte. D’ici là, rien ne change.</p>
    <p style="margin:0 0 16px;font-size:14px;">Le bouton ne marche pas&nbsp;? Copie ce lien dans ton navigateur&nbsp;:<br>
        <a href="{{ link }}" style="color:#111010;word-break:break-all;">{{ link }}</a></p>
    <p style="margin:0;padding:12px 14px;border:2px dashed #111010;font-size:14px;"><strong>Ce n'est pas toi&nbsp;?</strong> Ignore ce message&nbsp;: aucun compte n’utilisera cette adresse.</p>
{% endblock %}
