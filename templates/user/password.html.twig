{% extends 'user/user-dashboard.html.twig' %}

{#
    Mot de passe (maquette 15): the current password, then the new one with its rules ticked as
    one types, its confirmation telling the gap as one types. Changing it signs the other
    devices out (PutUserPasswordController); there is no list of them to show.
#}
{% block title %}Mot de passe{% endblock %}

{% block account_head %}
    <nav class="kb-account__crumbs" aria-label="Fil d’Ariane">
        <a href="{{ path('app_user_informations') }}">Mon compte</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Mot de passe</span>
    </nav>
    <h1 class="kb-account__title">Mot de passe</h1>
{% endblock %}

{% block content %}
    <div class="kb-password-page">
        {{ form_start(form, {attr: {class: 'kb-password-card', novalidate: 'novalidate'}}) }}
            {# Which account the new password is for, so that password managers save it there. #}
            <input type="email" name="username" value="{{ app.user.userIdentifier }}" autocomplete="username" hidden readonly>
            {% include 'security/_password_field.html.twig' with {
                field: form.current_password,
                rules: false,
                forgot: path('app_forgot_password_request'),
            } only %}
            {% include 'security/_password_field.html.twig' with {field: form.new_password.first} only %}
            {% include 'security/_password_field.html.twig' with {
                field: form.new_password.second,
                rules: false,
                confirms: form.new_password.first,
            } only %}
            <button type="submit" class="btn btn-primary btn-lg kb-password-card__submit">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>Changer le mot de passe
            </button>
        {{ form_end(form) }}

        <aside class="kb-password-aside" aria-labelledby="autres-appareils">
            <h2 class="kb-password-aside__title" id="autres-appareils">Tes autres appareils</h2>
            <p>Changer ton mot de passe déconnecte tous les appareils où ton compte est ouvert, celui-ci excepté, même ceux où tu avais coché « rester connecté ».</p>
            <p>Un appareil que tu ne reconnais pas, une commande que tu n’as pas passée&nbsp;? Change-le maintenant.</p>
        </aside>
    </div>
{% endblock %}
