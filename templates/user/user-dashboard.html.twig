{% extends 'base.html.twig' %}

{#
    Layout of the account pages (maquette 07): the account menu on the left from lg up, chips
    under the page title below. A page fills `account_head` (its title) and `content`.
    `counts` (App\Account\AccountTotals) is passed by pages that need it anyway.
#}
{% block body %}
    {% set account_head %}{% block account_head %}{% endblock %}{% endset %}
    <div class="container-xxl kb-account{{ account_head|trim ? '' : ' kb-account--headless' }}">
        {% if account_head|trim %}
            <div class="kb-account__head">{{ account_head }}</div>
        {% endif %}
        {% include 'layout/_sidebar.html.twig' with {counts: counts ?? account_counts(app.user)} only %}
        <div class="kb-account__main">
            {% block content %}{% endblock %}
        </div>
    </div>
{% endblock %}
