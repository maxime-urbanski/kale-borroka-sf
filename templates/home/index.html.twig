{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        {# lastArticles and lastProductions are queries: they only run on a cache miss. #}
        {% cache 'home_sections' tags(['article', 'album', 'style']) %}
            {% include 'layout/article/_section.html.twig' with {
                articles: lastArticles.result,
                title: 'Derniers Articles'
            } %}
            {% include 'layout/article/_section.html.twig' with {
                articles: lastProductions.result,
                title: 'Dernières prod'
            } %}
        {% endcache %}
    </div>
{% endblock %}
