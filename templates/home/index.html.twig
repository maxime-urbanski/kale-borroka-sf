{% extends 'base.html.twig' %}

{% block body %}
    {% if feature %}
        {% include 'home/_feature.html.twig' with {feature} only %}
    {% endif %}
    {# The sections' variables are queries: they only run on a cache miss. #}
    {% cache 'home_productions' tags(['article', 'album', 'style']) %}
        {% include 'home/_productions.html.twig' with {releases: lastProductions.result} only %}
    {% endcache %}
    {% if homepage.manifestoShown %}
        {# Back-office texts and the linked page: invalidated with either. #}
        {% cache 'home_label' tags(['homepage', 'page']) %}
            {% include 'home/_label.html.twig' with {homepage} only %}
        {% endcache %}
    {% endif %}
    {% cache 'home_latest' tags(['article', 'album', 'style']) %}
        {% include 'home/_latest.html.twig' with {shelves: latestArticles} only %}
    {% endcache %}
{% endblock %}
