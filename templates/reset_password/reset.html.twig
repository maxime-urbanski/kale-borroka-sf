{% extends 'security/_tract.html.twig' %}

{% block step_icon %}bi-shield-lock{% endblock %}
{% block step %}Étape 3 / 3{% endblock %}
{% block heading %}Nouveau mot de passe{% endblock %}

{% block card %}
    <p class="kb-tract__text">Choisis-en un solide. Tu seras connecté·e juste après.</p>
    {{ form_start(resetForm, {attr: {class: 'kb-tract__form'}}) }}
        {% include 'security/_password_field.html.twig' with {field: resetForm.plainPassword.first} only %}

        {% include 'security/_password_field.html.twig' with {
            field: resetForm.plainPassword.second,
            rules: false,
            confirms: resetForm.plainPassword.first,
        } only %}

        <button type="submit" class="btn btn-primary btn-lg w-100">
            Enregistrer et me connecter <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
    {{ form_end(resetForm) }}
{% endblock %}
