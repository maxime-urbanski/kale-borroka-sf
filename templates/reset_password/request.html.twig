{% extends 'security/_tract.html.twig' %}

{% block step_icon %}bi-key{% endblock %}
{% block step %}Étape 1 / 3{% endblock %}
{% block heading %}Mot de passe oublié&nbsp;?{% endblock %}

{% block card %}
    <p class="kb-tract__text">Indique l'e-mail de ton compte. On t'envoie un lien pour en choisir un nouveau.</p>
    {{ form_start(requestForm, {attr: {class: 'kb-tract__form'}}) }}
        {% include 'security/_form_errors.html.twig' with {form: requestForm} only %}
        {{ form_row(requestForm.email, {row_attr: {class: 'mb-0'}}) }}
        <button type="submit" class="btn btn-dark btn-lg w-100">Envoyer le lien</button>
    {{ form_end(requestForm) }}
{% endblock %}
