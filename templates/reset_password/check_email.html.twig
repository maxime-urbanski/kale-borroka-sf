{% extends 'security/_tract.html.twig' %}

{% block step_icon %}bi-envelope-check{% endblock %}
{% block step %}Étape 2 / 3{% endblock %}
{% block heading %}Regarde ta boîte mail.{% endblock %}

{# The same words whether or not an account exists: nothing tells them apart. #}
{% block card %}
    <p class="kb-tract__text">
        Si un compte existe pour {% if email %}<strong>{{ email }}</strong>{% else %}cette adresse{% endif %},
        un lien de réinitialisation vient de partir.
    </p>
    <div class="kb-tract__note">
        <strong>Rien reçu ?</strong>
        Vérifie tes spams. Le lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }} ;
        tu peux en redemander un après {{ retryMinutes }} minutes.
    </div>
    <a href="{{ path('app_forgot_password_request') }}" class="btn btn-outline-dark btn-lg w-100">Renvoyer le lien</a>
{% endblock %}
