{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Kale Borroka Records{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">Stock faible</div>
                <div class="list-group list-group-flush">
                    {% for article in lowStock %}
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                           href="{{ path('admin_article_edit', {entityId: article.id}) }}">
                            <span>{{ article.name }}</span>
                            <span class="badge {{ article.quantity > 0 ? 'text-bg-warning' : 'text-bg-danger' }}">
                                {{ article.quantity }}
                            </span>
                        </a>
                    {% else %}
                        <div class="list-group-item text-muted">Aucune offre en stock faible.</div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">Éditions sans offre</div>
                <div class="list-group list-group-flush">
                    {% for edition in editionsWithoutOffer %}
                        <a class="list-group-item list-group-item-action"
                           href="{{ path('admin_edition_edit', {entityId: edition.id}) }}">
                            {{ edition.fullName }}
                        </a>
                    {% else %}
                        <div class="list-group-item text-muted">Toutes les éditions ont au moins une offre.</div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Dernières commandes</div>
                <div class="list-group list-group-flush">
                    {% for order in lastOrders %}
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                           href="{{ path('admin_order_detail', {entityId: order.id}) }}">
                            <span>{{ order.reference }}</span>
                            <span class="text-muted">{{ order.createdAt|date('d/m/Y H:i') }}</span>
                            <span class="badge text-bg-dark">
                                {{ (order.totalPrice / 100)|format_currency('EUR', [], 'fr') }}
                            </span>
                        </a>
                    {% else %}
                        <div class="list-group-item text-muted">Aucune commande pour le moment.</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
