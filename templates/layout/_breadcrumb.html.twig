{% set route = app.request.attributes.get('_route') %}

<nav class="my-4" aria-label="Fil d'Ariane">
    <ol class="breadcrumb">
        {% for link in breadcrumb %}
            {% if link.path == route %}
                <li class="breadcrumb-item active" aria-current="page">{{ link.name }}</li>
            {% else %}
                <li class="breadcrumb-item">
                    <a href="{{ path(link.path, link.parameters|default([])) }}">{{ link.name }}</a>
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</nav>
