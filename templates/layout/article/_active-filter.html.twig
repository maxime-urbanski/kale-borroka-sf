{% set active_chips = [] %}
{% for category in ['artists', 'labels', 'styles'] %}
    {% for filter in attribute(filters, category)|default([]) %}
        {% set active_chips = active_chips|merge([{category, filter}]) %}
    {% endfor %}
{% endfor %}
{% if filters.supports|default([])|length > 1 %}
    {% for filter in filters.supports %}
        {% set active_chips = active_chips|merge([{category: 'supports', filter}]) %}
    {% endfor %}
{% endif %}

<div id="container-filter-active"
     class="d-flex align-items-center h-100 gap-2 overflow-x-scroll no-scroll-bar"
     data-scrollbar-target="children"
>
    {% for chip in active_chips %}
        <button type="button" class="kb-chip"
                data-controller="remove-filters"
                data-remove-filters-category-value="{{ chip.category }}"
                data-remove-filters-id-value="{{ chip.filter.id }}"
                data-action="remove-filters#remove"
                aria-label="Retirer le filtre {{ chip.filter.name }}">
            {{ chip.filter.name }}
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    {% endfor %}
</div>
