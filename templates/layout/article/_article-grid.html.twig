<div
    class="row row-cols-{{ col_sm|default(2) }} row-cols-md-{{ col_md|default(3) }} row-cols-lg-{{ col_lg|default(4) }}{% if col_xl is defined %} row-cols-xl-{{ col_xl }}{% endif %} g-4 gy-5">
    {% for article in articles %}
        <div class="col">
            {% include 'layout/article/_card.html.twig' with {article} %}
        </div>
    {% endfor %}
</div>
