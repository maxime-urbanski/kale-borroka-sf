<section class="mb-5">
    <h2 class="fs-3 text-center text-decoration-underline red w-content mx-auto {{ title_mb | default('mb-5') }}">
        {{ title | upper }}
    </h2>
    {% if articles is defined %}
        {% include 'layout/article/_article-grid.html.twig' with {
            articles,
            col_sm: 2,
            col_md: 3,
            col_lg: 4,
            col_xl: 5,
        } %}
    {% endif %}
    {% if tracklist is defined %}
        <div class="row">
            <div class="col">
                <ol class="list-unstyled fs-5 text-start w-content mb-0 mx-auto">
                    {% for track in tracklist %}
                        {# Compilations and splits credit each track to its own band. #}
                        {% set performer = track.artist|first %}
                        <li>
                            <span class="text-success">{{ track.track }}</span> - {{ track.name }}
                            {% if performer and album_artist is defined and performer.id != album_artist.id %}
                                <span class="text-secondary">({{ performer.name }})</span>
                            {% endif %}
                            {% if track.duration %}
                                <span class="text-secondary ms-2">{{ track.duration // 60 }}:{{ '%02d'|format(track.duration % 60) }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </div>
        </div>
    {% endif %}
</section>
