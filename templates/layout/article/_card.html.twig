{# One card per album. `support`, when set, narrows pricing and artwork to the pressings of
   that format — /catalog/lp must not advertise the CD price. #}
{% set scope = supportScope|default(null) %}
{% set preview = album.getPreviewEdition(scope) %}
{% set cover = album.getCoverImage(scope) %}
{% set cheapest = album.getCheapestArticle(scope) %}
<div class="card border-0 h-100">
    <div class="ratio ratio-1x1 position-relative">
        {% if album.kbrProduction %}
            <div class="overlay">
                <div class="ribbon">
                    <span>{{ album.kbrProductionId }}</span>
                </div>
            </div>
        {% endif %}
        {% if cover %}
            <img src="{{ asset('upload/albums/' ~ cover.imageName) }}" alt="{{ album.fullName }}">
        {% else %}
            <img src="{{ asset('/images/product_placeholder.png') }}" alt="{{ album.fullName }}">
        {% endif %}
    </div>
    <div class="card-body d-flex flex-column p-2">
        <p class="fs-6 fw-semibold mb-0">{{ album.fullName }}</p>
        <p class="text-secondary mb-0">
            {% for style in album.styles %}
                {{ style }}
            {% endfor %}
        </p>
        <div class="d-flex justify-content-between mt-2">
            <p class="fw-bolder mt-auto" style="font-size: 11px">
                {% for edition in album.getEditionsForSupport(scope)|slice(0, 3) %}
                    <span class="text-danger border border-danger px-2 py-1">
                        {{ edition.support | upper }}
                    </span>
                {% endfor %}
            </p>
            <p class="fs-6 fw-semibold mt-auto ">
                {% if cheapest %}
                    <span class="text-bg-dark mb-0 px-2 py-1">
                        {% if album.hasSeveralOffers(scope) %}<span class="fw-normal small">dès</span>{% endif %}
                        {{ (cheapest.price/100) | format_currency('EUR', [], 'fr') }}
                    </span>
                {% else %}
                    <span class="text-bg-secondary mb-0 px-2 py-1">Épuisé</span>
                {% endif %}
            </p>
        </div>
    </div>
</div>
