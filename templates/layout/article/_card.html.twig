{#
    Article card (design system: .kb-card). Rendered inside {% cache %} blocks: nothing that
    depends on the visitor, nor what StockManager writes (it does not invalidate the fragment).
#}
{% set album = article is release ? article.album : null %}
{% set artist = album ? album.artist : null %}
<article class="kb-card">
    <div class="kb-card__cover">
        {% if article.coverImageName %}
            <img src="{{ asset('upload/albums/' ~ article.coverImageName) }}"
                 alt="Pochette : {{ artist ? artist.name ~ ', ' }}{{ article.name }}"
                 loading="lazy">
        {% else %}
            <div class="kb-cover-missing" role="img"
                 aria-label="Pochette à venir : {{ article.name }}">
                <i class="bi bi-vinyl" aria-hidden="true"></i>
                <span aria-hidden="true">Pochette<br>à venir</span>
            </div>
        {% endif %}
        <div class="kb-card__badges">
            {% if album and album.kbrProduction and album.kbrProductionId %}
                <span class="kb-badge kb-badge--sm">{{ album.kbrProductionId }}</span>
            {% endif %}
            {% if article is release and article.limitedTo %}
                <span class="kb-badge kb-badge--sm"><i class="bi bi-hash" aria-hidden="true"></i>Ltd {{ article.limitedTo }} ex.</span>
            {% endif %}
            {% if article.itemCondition is same as(constant('App\\Enum\\ItemCondition::USED')) %}
                <span class="kb-badge kb-badge--sm kb-badge--papier"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>{{ article.itemCondition.label }}</span>
            {% endif %}
        </div>
    </div>
    <div class="kb-card__body">
        <div class="kb-card__meta">
            <span>{{ article.formatLabel }}</span>
            {% if article is release and article.label %}
                <span>{{ article.label.name }}</span>
            {% elseif article is book and article.author %}
                <span>{{ article.author }}</span>
            {% endif %}
        </div>
        <a href="{{ article_path(article) }}" class="kb-card__link">{{ artist ? artist.name : article.name }}</a>
        {% if artist %}
            <span class="kb-card__subtitle">{{ article.name }}</span>
        {% endif %}
        {% if album and album.styles is not empty %}
            <span class="kb-card__subtitle text-kb-gris small">{{ album.styles|join(' · ') }}</span>
        {% endif %}
        <div class="kb-card__footer">
            <span class="kb-price">{{ (article.price/100) | format_currency('EUR', [], 'fr') }}</span>
        </div>
    </div>
</article>
