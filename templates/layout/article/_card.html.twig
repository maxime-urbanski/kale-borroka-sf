{% set cover = edition.coverImage %}
{% set cheapest = edition.cheapestArticle %}
<div class="card border-0 h-100">
    <div class="ratio ratio-1x1 position-relative">
        {% if edition.album.kbrProduction %}
            <div class="overlay">
                <div class="ribbon">
                    <span>{{ edition.album.kbrProductionId }}</span>
                </div>
            </div>
        {% endif %}
        {% if cover %}
            <img src="{{ asset('upload/albums/' ~ cover.imageName) }}"
                 alt="{{ edition.album.fullName }}"
            >
        {% else %}
            <img src="{{ asset('/images/product_placeholder.png') }}"
                 alt="{{ edition.album.fullName }}"
            >
        {% endif %}
    </div>
    <div class="card-body d-flex flex-column p-2">
        <p class="fs-6 fw-semibold mb-0">{{ edition.album.fullName }}</p>
        <p class="text-secondary mb-0">
            {% for style in edition.album.styles %}
                {{ style }}
            {% endfor %}
        </p>
        {% if edition.color or edition.editionLabel %}
            <p class="text-secondary small mb-0">
                {{ [edition.color, edition.editionLabel]|filter(v => v)|join(' · ') }}
            </p>
        {% endif %}
        <div class="d-flex justify-content-between mt-2">
            <p class="fw-bolder mt-auto" style="font-size: 11px">
                <span class="text-danger border border-danger px-2 py-1">
                    {{ edition.support | upper }}
                </span>
            </p>
            <p class="fs-6 fw-semibold mt-auto ">
                {% if cheapest %}
                    <span class="text-bg-dark mb-0 px-2 py-1">
                        {% if edition.hasSeveralOffers %}<span class="fw-normal small">dès</span>{% endif %}
                        {{ (cheapest.price/100) | format_currency('EUR', [], 'fr') }}
                    </span>
                {% else %}
                    <span class="text-bg-secondary mb-0 px-2 py-1">Épuisé</span>
                {% endif %}
            </p>
        </div>
    </div>
</div>
