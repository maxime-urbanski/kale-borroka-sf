{#
    One-click action that changes something (cart, wishlist, collection): a POST form with
    a CSRF token, checked by App\Security\ActionCsrfToken. Same options as
    _obfuscation_link.html.twig, plus token_id.
#}
{% set icon_position = icon_position | default('left') %}

<form method="post" action="{{ url }}" class="d-inline-flex">
    <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
    <button type="submit" class="{{ class }}">
        {% if icon is defined and icon_position is same as "left" %}
            <i class="bi {{ icon }}"></i>
        {% endif %}
        {% if text_btn is defined %}
            {{ text_btn }}
        {% endif %}
        {% if icon is defined and icon_position is same as "right" %}
            <i class="bi {{ icon }}"></i>
        {% endif %}
    </button>
</form>
