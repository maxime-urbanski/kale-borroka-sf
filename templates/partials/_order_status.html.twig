{#
    Order status badge: an icon and the label for every status, the border style and the
    fill on top (design system: colour never carries the state alone). `status`: App\Enum\OrderStatus.
    `small` or `large` for the list cards and the order's page.
#}
{% set modifiers = {
    pending: 'kb-badge--pending',
    paid: 'kb-badge--outline',
    preparing: 'kb-badge--kraft',
    shipped: '',
    delivered: 'kb-badge--outline',
    cancelled: 'kb-badge--cancelled',
    refunded: 'kb-badge--refunded',
} %}
<span class="kb-badge {{ modifiers[status.value] }}{{ small|default(false) ? ' kb-badge--sm' }}{{ large|default(false) ? ' kb-badge--lg' }}"><i class="bi {{ status.icon }}" aria-hidden="true"></i>{{ status.label }}</span>
