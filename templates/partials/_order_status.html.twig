{#
    Order status badge: an icon and the label for every status, the border style and the
    fill on top (design system: colour never carries the state alone). `status`: App\Enum\OrderStatus.
#}
{% set badges = {
    pending: ['kb-badge--pending', 'bi-hourglass-split'],
    paid: ['kb-badge--outline', 'bi-check-lg'],
    preparing: ['kb-badge--kraft', 'bi-box-seam'],
    shipped: ['', 'bi-truck'],
    delivered: ['kb-badge--outline', 'bi-house-check'],
    cancelled: ['kb-badge--cancelled', 'bi-x-lg'],
    refunded: ['kb-badge--refunded', 'bi-arrow-counterclockwise'],
} %}
{% set badge = badges[status.value] %}
<span class="kb-badge {{ badge[0] }}{{ small|default(false) ? ' kb-badge--sm' }}"><i class="bi {{ badge[1] }}" aria-hidden="true"></i>{{ status.label }}</span>
