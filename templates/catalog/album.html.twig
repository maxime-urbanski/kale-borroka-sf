{% extends 'base.html.twig' %}

{% block body %}
    {# Every edition is rendered server-side and all but the selected one are hidden. The
       Stimulus controller only toggles visibility and retargets the cart form, so there is
       no client-side templating to drift out of sync — and the page still works without JS,
       each picker entry being a real link. #}
    <div class="container py-5"
         data-controller="edition-picker"
         data-edition-picker-selected-value="{{ selectedEdition.slug }}">
        {% include 'layout/_breadcrumb.html.twig' with {breadcrumb} %}
        <div class="row mb-5">
            <div class="col-sm-12 col-md-5">
                {% for edition in editions %}
                    {% set cover = edition.coverImage %}
                    <img src="{{ cover ? asset('upload/albums/' ~ cover.imageName) : asset('/images/product_placeholder.png') }}"
                         alt="{{ album.fullName }}"
                         class="w-100 ratio-1x1"
                         data-edition-picker-target="cover"
                         data-edition="{{ edition.slug }}"
                         {% if edition.slug != selectedEdition.slug %}hidden{% endif %}>
                {% endfor %}
            </div>
            <div class="col-sm-12 col-md-7 ps-lg-5">
                <div class="row mb-3">
                    <div class="col-12">
                        <h1 class="text-center text-md-start fw-bolder lh-1 mt-4 mt-md-0 mb-0">{{ album.fullName | upper }}</h1>
                        <p class="text-secondary mb-3">
                            {% for style in album.styles %}
                                {{ style }} {% if not loop.last %} | {% endif %}
                            {% endfor %}
                        </p>

                        {% if editions|length > 1 %}
                            <div class="btn-group flex-wrap mb-3" role="group" aria-label="Éditions disponibles">
                                {% for edition in editions %}
                                    <a href="{{ path('app_catalog_show', {
                                           support: edition.support.name,
                                           slug: album.slug,
                                           edition: edition.slug
                                       }) }}"
                                       class="btn btn-outline-dark {{ edition.slug == selectedEdition.slug ? 'active' : '' }}"
                                       data-edition-picker-target="choice"
                                       data-edition="{{ edition.slug }}"
                                       data-action="edition-picker#select">
                                        {{ edition.name }}
                                        {%- if edition.color %} <span class="small">({{ edition.color }})</span>{% endif %}
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% for edition in editions %}
                            <div data-edition-picker-target="panel"
                                 data-edition="{{ edition.slug }}"
                                 {% if edition.slug != selectedEdition.slug %}hidden{% endif %}>
                                <div class="d-flex align-items-center flex-wrap">
                                    <p class="fs-5 fw-bolder m-0">
                                        <span class="text-danger border border-danger px-2 py-1">
                                            {{ edition.support | upper }}
                                        </span>
                                    </p>
                                    {% if edition.editionLabel %}
                                        <p class="fs-6 ms-3 my-auto">
                                            <span class="badge text-bg-warning">{{ edition.editionLabel }}</span>
                                        </p>
                                    {% endif %}
                                    {% if edition.pressingRun %}
                                        <p class="fs-6 ms-3 my-auto text-secondary">
                                            Tirage limité à {{ edition.pressingRun }} exemplaires
                                        </p>
                                    {% endif %}
                                </div>

                                {% set editionOffers = offers[edition.id] ?? [] %}
                                {% if editionOffers is empty %}
                                    <p class="fs-5 mt-3 text-secondary">Cette édition n'est pas disponible à la vente.</p>
                                {% else %}
                                    <div class="mt-3">
                                        {% for offer in editionOffers %}
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="offer-{{ edition.id }}"
                                                       id="offer-{{ offer.id }}"
                                                       value="{{ offer.id }}"
                                                       data-edition-picker-target="offer"
                                                       data-edition="{{ edition.slug }}"
                                                       data-article-id="{{ offer.id }}"
                                                       data-quantity="{{ offer.quantity }}"
                                                       data-action="edition-picker#selectOffer"
                                                       {% if loop.first %}checked{% endif %}
                                                       {% if not offer.purchasable %}disabled{% endif %}>
                                                <label class="form-check-label" for="offer-{{ offer.id }}">
                                                    <span class="fw-semibold">{{ offer.condition.label }}</span>
                                                    —
                                                    <span class="text-bg-dark px-2 py-1">
                                                        <bdi>{{ (offer.price/100) | format_currency('EUR', [], 'fr') }}</bdi>
                                                    </span>
                                                    {% if not offer.purchasable %}
                                                        <span class="badge text-bg-secondary ms-2">{{ offer.availability.label }}</span>
                                                    {% elseif offer.availability.value == 'pre_order' %}
                                                        <span class="badge text-bg-info ms-2">
                                                            {{ offer.availability.label }}{% if offer.availableFrom %} — {{ offer.availableFrom|date('d/m/Y') }}{% endif %}
                                                        </span>
                                                    {% endif %}
                                                </label>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                {% if edition.description %}
                                    <p class="mt-3 mb-0 text-secondary">{{ edition.description }}</p>
                                {% endif %}
                                {% if edition.catalogNumber %}
                                    <p class="mb-0 small text-secondary">Réf. catalogue : {{ edition.catalogNumber }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}

                        <p class="mt-3 mb-md-0">Release date: {{ album.dateRelease|date('Y') }}</p>
                    </div>
                </div>
                {% if form %}
                    <div class="row mb-3">
                        <div class="col">
                            {{ form_start(form) }}
                            {{ form_widget(form.articleId) }}
                            <div class="d-flex justify-content-between justify-content-md-start">
                                <div class="input-group w-content" data-controller='add-to-cart'>
                                    {{ form_widget(form.less) }}
                                    {{ form_widget(form.quantity) }}
                                    {{ form_widget(form.more) }}
                                </div>
                                <button class="ms-md-3 btn btn-success rounded-0">
                                    Ajouter au panier
                                    <i class="bi bi-minecart d-none d-md-inline ms-1"></i>
                                </button>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                {% endif %}
                {% if app.user %}
                    {% set wishlistArticle = selectedEdition.cheapestArticle ?? (offers[selectedEdition.id] ?? [])|first %}
                    {% if wishlistArticle %}
                        <div class="btn-group mb-3 w-100" role="group">
                            {% if userWishlist and userWishlist.hasInWishlist(wishlistArticle) %}
                                {% include 'partials/_obfuscation_link.html.twig' with {
                                    url: path('app_wishlist_remove', {productId: wishlistArticle.id}),
                                    class: 'btn btn-danger',
                                    text_btn: 'Retirer de la wishlist',
                                    icon: "bi-eye-slash-fill ms-2",
                                    icon_position: 'right'
                                } %}
                            {% else %}
                                {% include 'partials/_obfuscation_link.html.twig' with {
                                    url: path('app_wishlist_add', {productId: wishlistArticle.id}),
                                    class: 'btn btn-outline-dark',
                                    text_btn: 'Ajouter à la wantlist',
                                    icon: "bi-eye-fill me-2",
                                    icon_position: 'left'
                                } %}
                            {% endif %}
                            {% if userCollection and userCollection.hasInCollection(wishlistArticle) %}
                                {% include 'partials/_obfuscation_link.html.twig' with {
                                    url: path('app_collection_remove', {productId: wishlistArticle.id}),
                                    class: 'btn btn-danger',
                                    text_btn: 'Supprimer de la collection',
                                    icon: "bi-database-fill-dash ms-2",
                                    icon_position: 'right'
                                } %}
                            {% else %}
                                {% include 'partials/_obfuscation_link.html.twig' with {
                                    url: path('app_collection_add', {productId: wishlistArticle.id}),
                                    class: 'btn btn-outline-dark',
                                    text_btn: 'Ajouter à la collection',
                                    icon: "bi-database-fill-add me-2",
                                    icon_position: 'left'
                                } %}
                            {% endif %}
                        </div>
                    {% endif %}
                {% endif %}
                <hr>
                <div class="row">
                    <div class="col">
                        <p class="m-0 text-center">{{ album.note }}</p>
                    </div>
                </div>
            </div>
        </div>
        {% if album.tracklists|length %}
            {% include 'layout/article/_section.html.twig' with {
                tracklist: album.tracklists,
                title: 'Tracklist',
                title_mb: 'mb-4'
            } %}
        {% endif %}
        {% if albumsByArtist|length %}
            {% include 'layout/article/_section.html.twig' with {
                albums: albumsByArtist,
                title: 'Du même artiste',
                title_mb: 'mb-5'
            } %}
        {% endif %}
        {% if albumsSameStyle|length %}
            {% include 'layout/article/_section.html.twig' with {albums: albumsSameStyle, title: 'Dans le même style'} %}
        {% endif %}
    </div>
{% endblock %}
