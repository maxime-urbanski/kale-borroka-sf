{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">
        {% include 'layout/_breadcrumb.html.twig' with {breadcrumb} %}
        <div class="row mb-5">
            <div class="col-sm-12 col-md-5">
                {% if article.coverImageName %}
                    <img src="{{ asset('upload/albums/' ~ article.coverImageName) }}"
                         alt="{{ article.name }}"
                         class="w-100 ratio-1x1">
                {% else %}
                    <img src="{{ asset('/images/product_placeholder.png') }}" alt="{{ article.name }}"
                         class="w-100 ratio-1x1">
                {% endif %}
            </div>
            <div class="col-sm-12 col-md-7 ps-lg-5">
                <div class="row mb-3">
                    <div class="col-12">
                        <h1 class="text-center text-md-start mt-4 mt-md-0 mb-2">{{ article.name }}</h1>
                        <p class="text-secondary mb-3">
                            {% if article is release %}
                                {% for style in article.album.styles %}
                                    {{ style }} {% if not loop.last %} | {% endif %}
                                {% endfor %}
                            {% elseif article is book %}
                                {{ article.author }}
                            {% endif %}
                        </p>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <span class="kb-price kb-price--lg{{ article.soldOut ? ' kb-price--sold' }}">
                                <bdi>{{ (article.price/100) | format_currency('EUR', [], 'fr') }}</bdi>
                            </span>
                            <span class="kb-badge">{{ article.formatLabel }}</span>
                        </div>
                        {% if article is release %}
                            <p class="mt-3 mb-md-0">
                                Sortie : {{ article.album.dateRelease ? article.album.dateRelease|date('Y') : '—' }}
                                {% if article.color %} · {{ article.color }}{% endif %}
                                {% if article.editionLabel %} · {{ article.editionLabel }}{% endif %}
                                {% if article.limitedTo %} · Limité à {{ article.limitedTo }} ex.{% endif %}
                            </p>
                        {% endif %}
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col">
                        {% if article.soldOut %}
                            {# Adding it would fail anyway (« Cet article est épuisé. »): no button to press. #}
                            <p class="mb-0 py-2">
                                <span class="kb-stamp">Épuisé</span>
                            </p>
                        {% else %}
                            {{ form_start(form) }}
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="kb-quantity" data-controller="add-to-cart">
                                    {{ form_widget(form.less) }}
                                    {{ form_widget(form.quantity) }}
                                    {{ form_widget(form.more) }}
                                </div>
                                <button class="btn btn-primary btn-lg">
                                    <i class="bi bi-bag-plus" aria-hidden="true"></i>
                                    Ajouter au panier
                                </button>
                            </div>
                            {{ form_end(form) }}
                        {% endif %}
                    </div>
                </div>
                {% if app.user %}
                    <div class="btn-group mb-3 w-100" role="group">
                        {% if app.user and userWishlist and userWishlist.hasInWishlist(article) %}
                            {% include 'partials/_post_button.html.twig' with {
                                token_id: 'wishlist',
                                url: path('app_wishlist_remove', {productId: article.id}),
                                class: 'btn btn-danger',
                                text_btn: 'Retirer de la wishlist',
                                icon: "bi-eye-slash-fill ms-2",
                                icon_position: 'right'
                            } %}
                        {% else %}
                            {% include 'partials/_post_button.html.twig' with {
                                token_id: 'wishlist',
                                url: path('app_wishlist_add', {productId: article.id}),
                                class: 'btn btn-outline-dark',
                                text_btn: 'Ajouter à la wantlist',
                                icon: "bi-eye-fill me-2",
                                icon_position: 'left'
                            } %}
                        {% endif %}
                        {% if app.user and userCollection and userCollection.hasInCollection(article) %}
                            {% include 'partials/_post_button.html.twig' with {
                                token_id: 'collection',
                                url: path('app_collection_remove', {productId: article.id}),
                                class: 'btn btn-danger',
                                text_btn: 'Supprimer de la collection',
                                icon: "bi-database-fill-dash ms-2",
                                icon_position: 'right'
                            } %}
                        {% else %}
                            {% include 'partials/_post_button.html.twig' with {
                                token_id: 'collection',
                                url: path('app_collection_add', {productId: article.id}),
                                class: 'btn btn-outline-dark',
                                text_btn: 'Ajouter à la collection',
                                icon: "bi-database-fill-add me-2",
                                icon_position: 'left'
                            } %}
                        {% endif %}
                    </div>
                {% endif %}
                <hr>
                <div class="row">
                    <div class="col">
                        <p class="m-0 text-center">{{ article is release ? article.album.note }}</p>
                    </div>
                </div>
            </div>
        </div>
        {% if tracklist %}
            {# Shared by every pressing of the album. A song or an artist written clears `album` too. #}
            {% cache 'album_tracklist_' ~ article.album.id tags(['album']) %}
                {% set tracks = tracklist.result %}
                {% if tracks is not empty %}
                    {% include 'layout/article/_section.html.twig' with {
                        tracklist: tracks,
                        album_artist: article.album.artist,
                        title: 'Tracklist',
                        title_mb: 'mb-4'
                    } %}
                {% endif %}
            {% endcache %}
        {% endif %}
        {# The same for every visitor, unlike the rest of the page (stock, wishlist, cart form). #}
        {% cache 'article_related_' ~ article.id tags(['article', 'album', 'style']) %}
            {% set byArtist = articleByArtist ? articleByArtist.result : [] %}
            {% set sameStyle = articleSameStyle ? articleSameStyle.result : [] %}
            {% if byArtist|length > 1 %}
                {% include 'layout/article/_section.html.twig' with {
                    articles: byArtist,
                    title: 'Du même artiste',
                    title_mb: 'mb-5'
                } %}
            {% endif %}
            {% if sameStyle|length > 1 %}
                {% include 'layout/article/_section.html.twig' with {articles: sameStyle, title: 'Dans le même style'} %}
            {% endif %}
        {% endcache %}
    </div>
{% endblock %}
