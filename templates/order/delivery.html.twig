{% extends 'order/index.html.twig' %}

{% block title %}Ta commande{% endblock %}

{# How each way of paying works, shown on its card. A payment without an entry shows its name only. #}
{% set payment_help = {
    paypal: ['On t\'envoie un lien PayPal.me avec le montant exact, port compris.', 'Paiement en « Biens et services » (tu es protégé), avec ta référence en note.'],
    vinted: ['On crée une annonce réservée pour toi et on t\'envoie le lien.', 'Tu achètes sur Vinted : paiement, port et suivi passent par Vinted.'],
} %}

{% macro choice_cards(field, kind, help) %}
    {% for choice in field.vars.choices %}
        {% set child = field[choice.value] %}
        <div class="kb-choice kb-choice--{{ kind }}">
            {# Bare radio: the Bootstrap widget wraps it in a .form-check block that pushes the card down. #}
            <input type="radio" class="kb-choice__input" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" value="{{ child.vars.value }}"{{ child.vars.checked ? ' checked' }} required>
            <label class="kb-choice__card" for="{{ child.vars.id }}">
                {% if kind == 'address' %}
                    {% set address = choice.data %}
                    <span class="kb-choice__head">
                        <span class="kb-choice__title">{{ address.name ?: (address.firstname ~ ' ' ~ address.lastname) }}</span>
                        {% if address is same as(app.user.defaultAddress) %}<span class="kb-badge kb-badge--sm kb-choice__tag">Par défaut</span>{% endif %}
                    </span>
                    <span class="kb-choice__text">{{ address.firstname }} {{ address.lastname }}</span>
                    <span class="kb-choice__text">{{ address.address }}{% if address.complementAddress %}, {{ address.complementAddress }}{% endif %}<br>{{ address.zipcode }} {{ address.city }} · {{ address.country }}</span>
                {% else %}
                    {% set name = choice.data.name %}
                    <span class="kb-choice__head">
                        <span class="kb-choice__title kb-choice__title--big">{{ name }}</span>
                        <span class="kb-badge kb-badge--sm kb-choice__tag">{{ name }}</span>
                    </span>
                    {% if help[name|lower] is defined %}
                        <ul class="kb-choice__list">{% for line in help[name|lower] %}<li>{{ line }}</li>{% endfor %}</ul>
                    {% endif %}
                {% endif %}
                {# Both marks: CSS shows the one matching :checked, so it follows the buyer's clicks. #}
                <span class="kb-choice__mark" aria-hidden="true"><i class="bi bi-square"></i><i class="bi bi-check-square-fill"></i></span>
                <span class="kb-choice__chosen"><i class="bi bi-check-lg" aria-hidden="true"></i> {{ kind == 'address' ? 'Choisie' : 'Choisi' }}</span>
            </label>
        </div>
    {% endfor %}
{% endmacro %}

{% block order_title %}
    {% include 'order/_steps.html.twig' with {current: 2} %}
    <div class="kb-order__heading">
        <h1 class="kb-cart__title kb-order__title">Ta commande</h1>
        <a class="kb-cart__more" href="{{ path('app_cart_index') }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Retour au panier</a>
    </div>
{% endblock %}

{% block left %}
    {{ form_start(form, {attr: {class: 'kb-order__form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {% for field, kind in {deliveryAddress: 'address', paymentMethod: 'payment'} %}
            <fieldset class="kb-fieldset">
                <legend class="kb-fieldset__legend">{{ loop.index }} · {{ form[field].vars.label }}</legend>
                {{ form_errors(form[field]) }}
                <div class="kb-fieldset__choices kb-fieldset__choices--{{ kind }}">
                    {{ _self.choice_cards(form[field], kind, payment_help) }}
                </div>
                {% if kind == 'address' %}
                    <a class="kb-choice__add" href="{{ path('app_user_addresses_index') }}?ajouter"><i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter une adresse</a>
                    <p class="kb-fieldset__help">Pour Vinted, l'adresse sert à préparer ton annonce ; l'étiquette d'envoi viendra de Vinted.</p>
                {% endif %}
                {# The cards above are the widget: form_end() must not print it a second time. #}
                {% do form[field].setRendered %}
            </fieldset>
        {% endfor %}
        <fieldset class="kb-fieldset">
            <legend class="kb-fieldset__legend">3 · Un mot pour nous ?</legend>
            {{ form_row(form.message, {label_attr: {class: 'fw-bold'}}) }}
        </fieldset>
        <div class="kb-order__notice kb-shadow">
            <span class="kb-order__notice-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
            <p><strong>Aucun paiement maintenant.</strong> On vérifie le stock à la main et on t'écrit sous 48 h avec le montant à régler, port compris.</p>
        </div>
        <div class="kb-order__actions">
            {{ form_widget(form.submit, {attr: {class: 'btn btn-buy btn-lg w-100'}}) }}
            <p class="kb-order__after">Tu recevras un mail de confirmation. Pas de prélèvement, pas de carte bancaire.</p>
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block rigth %}
    <aside class="kb-recap kb-shadow" aria-labelledby="order-recap-title">
        <div class="kb-recap__head">
            <h2 id="order-recap-title" class="kb-recap__title">Ta commande</h2>
            <a href="{{ path('app_cart_index') }}">Modifier</a>
        </div>
        <ul class="kb-recap__lines">
            {% for line in cart %}
                {% set article = line.product %}
                <li class="kb-recap__line">
                    {% if article.coverImageName %}
                        <img src="{{ asset('upload/albums/' ~ article.coverImageName) }}" alt="" width="56" height="56" loading="lazy">
                    {% else %}
                        <span class="kb-cover-missing kb-recap__cover" aria-hidden="true"></span>
                    {% endif %}
                    <span class="kb-recap__what"><strong>{{ article.name }}</strong><span>{{ article.formatLabel }} · {{ line.quantity }} × {{ (article.price / 100)|format_currency('EUR') }}</span></span>
                    <span class="kb-recap__amount">{{ (article.price * line.quantity / 100)|format_currency('EUR') }}</span>
                </li>
            {% endfor %}
        </ul>
        <div class="kb-recap__total">
            <span class="kb-recap__total-label">Total articles</span>
            <span class="kb-recap__total-price">{{ (total / 100)|format_currency('EUR') }}</span>
        </div>
        <p class="kb-recap__shipping"><i class="bi bi-truck" aria-hidden="true"></i> <span><strong>+ port, PayPal :</strong> calculé à la main et communiqué par mail avec ton lien de paiement.</span></p>
        <p class="kb-recap__fine">Avec Vinted : « + port : géré par Vinted ».</p>
    </aside>
{% endblock %}
