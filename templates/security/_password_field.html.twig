{#
    A password field: show/hide toggle, then the rules of App\Validator\PasswordRequirements
    ticked as one types (password Stimulus controller; without JS they read as a plain list).
    Rendered piece by piece, so the errors are linked here: form_row() is what usually does it.

    field: the FormView of the password input
    rules: false for a confirmation field or the current password (default true)
    forgot: a URL, shown as « Oublié ? » next to the label
    confirms: the FormView of the new password this field repeats: the gap is told as one types
#}
{% set password_rules = 'App\\Validator\\PasswordRequirements' %}
{% set with_rules = rules is defined ? rules : true %}
{% set rules_id = field.vars.id ~ '_rules' %}
{% set mismatch_id = field.vars.id ~ '_mismatch' %}
{% set error_ids = field.vars.errors|map((_, index) => field.vars.id ~ '_error' ~ (index + 1)) %}
{% set help_ids = field.vars.help ? [field.vars.id ~ '_help'] : [] %}
{% set described_by = (with_rules ? [rules_id] : [])|merge(help_ids)|merge(confirms is defined ? [mismatch_id] : [])|merge(error_ids) %}
<div data-controller="password"{% if confirms is defined %} data-password-confirms-value="{{ confirms.vars.id }}"{% endif %}>
    {% if forgot is defined %}
        <div class="kb-connect__label-row">
            {{ form_label(field) }}
            <a href="{{ forgot }}">Oublié ?</a>
        </div>
    {% else %}
        {{ form_label(field) }}
    {% endif %}
    <div class="kb-password">
        {{ form_widget(field, {attr: field.vars.attr|merge({
            'data-password-target': 'input',
            'data-action': 'password#check',
        })|merge(described_by ? {'aria-describedby': described_by|join(' ')} : {})
          |merge(error_ids ? {'aria-invalid': 'true'} : {})}) }}
        {% include 'security/_password_toggle.html.twig' %}
    </div>
    {% if with_rules %}
    <div class="kb-password-meter" data-password-target="meter" aria-hidden="true" hidden>
        <span></span><span></span><span></span><span></span>
    </div>
    <ul class="kb-password-rules" id="{{ rules_id }}">
        <li data-password-target="rule" data-min="{{ constant(password_rules ~ '::MIN_LENGTH') }}">
            <i class="bi bi-dash" aria-hidden="true"></i>
            {{ constant(password_rules ~ '::MIN_LENGTH') }} caractères minimum<span class="visually-hidden" data-state></span>
        </li>
        <li data-password-target="rule" data-pattern="{{ constant(password_rules ~ '::DIGIT_OR_SYMBOL') }}">
            <i class="bi bi-dash" aria-hidden="true"></i>
            Un chiffre ou un symbole<span class="visually-hidden" data-state></span>
        </li>
    </ul>
    {% endif %}
    {{ form_help(field) }}
    {% if confirms is defined %}
        {# Filled by the controller; polite, so a screen reader hears it once typing pauses. #}
        <p class="kb-password-mismatch" id="{{ mismatch_id }}" data-password-target="mismatch" aria-live="polite"></p>
    {% endif %}
    {{ form_errors(field) }}
</div>
