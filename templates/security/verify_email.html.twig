{% extends 'security/_tract.html.twig' %}

{#
    The link of the verification mail, opened (VerifyEmailController): one button, posted to
    the same signed URL. `email`: the address the link proves.
#}
{% block step_icon %}bi-envelope-check{% endblock %}
{% block step %}Dernière étape{% endblock %}
{% block heading %}Confirme ton adresse.{% endblock %}

{% block card %}
    <p class="kb-tract__text">Un clic et <strong>{{ email }}</strong> est confirmée : tu pourras commander.</p>
    <form method="post" action="{{ app.request.uri }}">
        <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Security\\ActionCsrfToken::EMAIL_VERIFICATION')) }}">
        <button type="submit" class="btn btn-primary btn-lg w-100">Confirmer mon adresse</button>
    </form>
{% endblock %}
