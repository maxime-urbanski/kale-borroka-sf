<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kale Borroka Records | {% block title %}Label & distro antifasciste depuis 2019{% endblock %}</title>
    <meta name="theme-color" content="#111010">
    <link rel="apple-touch-icon" sizes="180x180" href={{ asset("/apple-touch-icon.png") }}>
    <link rel="icon" type="image/png" sizes="32x32" href={{ asset("/favicon-32x32.png") }}>
    <link rel="icon" type="image/png" sizes="16x16" href={{ asset("/favicon-16x16.png") }}>
    <link rel="manifest" href={{ asset("/site.webmanifest") }}>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>
<a href="#contenu" class="kb-skip-link">Aller au contenu</a>
<header class="kb-header">
    {{ render(controller('App\\Controller\\MenuController::navbar')) }}
</header>
{% include 'layout/_toast.html.twig' %}
<main id="contenu" class="kb-main" tabindex="-1">
    {% block body %}
        <div class="container">
            <h1>Kale Borroka Home</h1>
        </div>
    {% endblock %}
</main>
{# Same for every visitor: the sub-request only runs on a cache miss. The year is in the key. #}
{% cache 'footer_' ~ 'now'|date('Y') tags(['support', 'social_network', 'page']) %}
    {{ render(controller('App\\Controller\\Layout\\FooterController')) }}
{% endcache %}
</body>
</html>
