{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Security headers for every response. The pages' Content-Security-Policy comes from
	# Symfony (App\Security\ContentSecurityPolicy), which knows each page's script nonce.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Uploaded SVGs (older than the upload rule refusing them) must not run scripts when
	# opened directly: they are served from the shop's own origin.
	@uploadedSvg path_regexp (?i)^/(upload|media)/.*\.svg$
	header @uploadedSvg Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
