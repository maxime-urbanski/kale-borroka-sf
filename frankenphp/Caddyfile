{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		# Worker mode is intentionally not enabled yet: it requires FrankenPHP support
		# in symfony/runtime, which landed in Symfony 7.4. Enable it together with the
		# Symfony 8 upgrade by adding:
		#   worker {
		#       file ./public/index.php
		#       {$FRANKENPHP_WORKER_CONFIG}
		#   }
	}

	file_server {
		hide *.php
	}
}
