{
	email {$ACME_EMAIL}
}

# The shop sees the hostname alone: a port sent by the client (Host: domain:6666) would end
# up in the absolute URLs of its mails.
(shop) {
	reverse_proxy {args[0]}:80 {
		header_up Host {host}
		{block}
	}
}

www.{$KBR_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	redir https://{$KBR_DOMAIN}{uri} permanent
}

{$KBR_DOMAIN} {
	import shop kbr-prod
}

preprod.{$KBR_DOMAIN} {
	# Not for the public nor for search engines.
	header X-Robots-Tag "noindex, nofollow"
	basic_auth {
		{$PREPROD_BASIC_AUTH_USER} {$PREPROD_BASIC_AUTH_HASH}
	}
	import shop kbr-preprod {
		# The preprod password stops here, out of the shop's logs and $_SERVER.
		header_up -Authorization
	}
}
