{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Neulis Alt|Ubuntu))/i]",
        "message": "Font not provided by the design system. Available: Neulis Alt, Ubuntu."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--lt-border",
      "--lt-font-body",
      "--lt-font-display",
      "--lt-grey",
      "--lt-grey-dark",
      "--lt-grey-extra-light",
      "--lt-grey-light",
      "--lt-info-bg",
      "--lt-info-fg",
      "--lt-ink",
      "--lt-leading-normal",
      "--lt-leading-tight",
      "--lt-leaf",
      "--lt-leaf-bl",
      "--lt-leaf-br",
      "--lt-leaf-tl",
      "--lt-leaf-tr",
      "--lt-negative-bg",
      "--lt-negative-fg",
      "--lt-orange",
      "--lt-orange-hover",
      "--lt-orange-tint",
      "--lt-radius-lg",
      "--lt-radius-md",
      "--lt-radius-sm",
      "--lt-secondary",
      "--lt-shadow-card",
      "--lt-space-1",
      "--lt-space-2",
      "--lt-space-3",
      "--lt-space-4",
      "--lt-space-5",
      "--lt-space-6",
      "--lt-space-7",
      "--lt-surface-alt",
      "--lt-text",
      "--lt-text-body",
      "--lt-text-display",
      "--lt-text-h1",
      "--lt-text-h2",
      "--lt-text-h3",
      "--lt-text-label",
      "--lt-text-muted",
      "--lt-text-small",
      "--lt-text-stat",
      "--lt-tracking-label",
      "--lt-underline-gap",
      "--lt-underline-h",
      "--lt-underline-w",
      "--lt-weight-bold",
      "--lt-weight-medium",
      "--lt-weight-regular",
      "--lt-white"
    ],
    "tokenKinds": {
      "--lt-orange": "color",
      "--lt-orange-hover": "color",
      "--lt-orange-tint": "color",
      "--lt-secondary": "color",
      "--lt-ink": "color",
      "--lt-white": "color",
      "--lt-grey-extra-light": "color",
      "--lt-grey-light": "color",
      "--lt-grey": "color",
      "--lt-grey-dark": "color",
      "--lt-text": "font",
      "--lt-surface-alt": "color",
      "--lt-border": "color",
      "--lt-text-muted": "font",
      "--lt-negative-bg": "color",
